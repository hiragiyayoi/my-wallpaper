{
  "name": "my-wallpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DJ Turntable Live Wallpaper - cross-platform HTML live wallpaper",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fallback:render": "node scripts/render-fallback.mjs",
    "fallback:video": "node scripts/export-video.mjs",
    "fallback": "npm run build && npm run fallback:render"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
